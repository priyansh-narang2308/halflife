# Halflife environment template.
# Copy to .env (gitignored) and fill in. Load into your shell with:
#   set -a; source .env; set +a
# Bifrost reads provider keys from the environment via "env.<NAME>" references in its config.

# --- Required for live validation ---------------------------------------------

# Tavily Search/Extract, routed through a Bifrost relay (Tasks 20-23).
# Free plan: 1,000 credits/month.
TAVILY_API_KEY=

# LLM provider for the verifier and the demo apps (Bifrost's native "openrouter" provider).
# Free models (IDs ending ":free"): 20 requests/min, and 50 requests/day until the
# account has bought >= $10 of credits (then 1,000/day).
OPENROUTER_API_KEY=

# --- Optional: a second provider for the cross-provider fallback demo (Task 42) ---
# OpenRouter alone can demo model-to-model fallback; a second provider shows
# provider-to-provider fallback. Fill in any one.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Bifrost dashboard/admin API. Without it, /api/* returns 403 on a fresh
# instance and the first admin account can't be created. Generate locally:
#   openssl rand -hex 24
BIFROST_SETUP_TOKEN=

# --- Local infrastructure (not secrets) ----------------------------------------
REDIS_ADDR=localhost:6380
