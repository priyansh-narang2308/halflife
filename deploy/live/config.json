{
  "$schema": "https://www.getbifrost.ai/schema",
  "providers": {
    "openrouter": {
      "keys": [
        {
          "name": "openrouter",
          "value": "env.OPENROUTER_API_KEY",
          "models": [
            "nvidia/nemotron-3.5-super-vl:free",
            "xingchen-agi/xing4.0-29b-a4b:free",
            "openrouter/free"
          ],
          "weight": 1.0
        }
      ]
    }
  },
  "governance": {
    "customers": [
      {
        "id": "cust-acme",
        "name": "Acme"
      },
      {
        "id": "cust-globex",
        "name": "Globex"
      },
      {
        "id": "cust-initech",
        "name": "Initech"
      }
    ],
    "virtual_keys": [
      {
        "name": "Acme app",
        "id": "vk-acme",
        "value": "sk-bf-halflife-acme",
        "is_active": true,
        "customer_id": "cust-acme",
        "provider_configs": [
          {
            "provider": "openrouter",
            "allowed_models": [
              "nvidia/nemotron-3.5-super-vl:free",
              "xingchen-agi/xing4.0-29b-a4b:free",
              "openrouter/free"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          }
        ]
      },
      {
        "name": "Globex app",
        "id": "vk-globex",
        "value": "sk-bf-halflife-globex",
        "is_active": true,
        "customer_id": "cust-globex",
        "provider_configs": [
          {
            "provider": "openrouter",
            "allowed_models": [
              "nvidia/nemotron-3.5-super-vl:free",
              "xingchen-agi/xing4.0-29b-a4b:free",
              "openrouter/free"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          }
        ]
      },
      {
        "name": "Initech app",
        "id": "vk-initech",
        "value": "sk-bf-halflife-initech",
        "is_active": true,
        "customer_id": "cust-initech",
        "provider_configs": [
          {
            "provider": "openrouter",
            "allowed_models": [
              "nvidia/nemotron-3.5-super-vl:free",
              "xingchen-agi/xing4.0-29b-a4b:free",
              "openrouter/free"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          }
        ]
      },
      {
        "name": "Halflife verifier for Acme",
        "id": "vk-verifier-acme",
        "value": "sk-bf-halflife-verifier-acme",
        "is_active": true,
        "customer_id": "cust-acme",
        "relay_grants": [
          {
            "relay_name": "tavily"
          }
        ],
        "provider_configs": [
          {
            "provider": "openrouter",
            "allowed_models": [
              "nvidia/nemotron-3.5-super-vl:free",
              "xingchen-agi/xing4.0-29b-a4b:free",
              "openrouter/free"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          }
        ]
      },
      {
        "name": "Halflife verifier for Globex",
        "id": "vk-verifier-globex",
        "value": "sk-bf-halflife-verifier-globex",
        "is_active": true,
        "customer_id": "cust-globex",
        "relay_grants": [
          {
            "relay_name": "tavily"
          }
        ],
        "provider_configs": [
          {
            "provider": "openrouter",
            "allowed_models": [
              "nvidia/nemotron-3.5-super-vl:free",
              "xingchen-agi/xing4.0-29b-a4b:free",
              "openrouter/free"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          }
        ]
      },
      {
        "name": "Halflife verifier for Initech",
        "id": "vk-verifier-initech",
        "value": "sk-bf-halflife-verifier-initech",
        "is_active": true,
        "customer_id": "cust-initech",
        "relay_grants": [
          {
            "relay_name": "tavily"
          }
        ],
        "provider_configs": [
          {
            "provider": "openrouter",
            "allowed_models": [
              "nvidia/nemotron-3.5-super-vl:free",
              "xingchen-agi/xing4.0-29b-a4b:free",
              "openrouter/free"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          }
        ]
      }
    ],
    "budgets": [
      {
        "id": "budget-app-acme",
        "max_limit": 1,
        "reset_duration": "1h",
        "virtual_key_id": "vk-acme"
      },
      {
        "id": "budget-app-globex",
        "max_limit": 1,
        "reset_duration": "1h",
        "virtual_key_id": "vk-globex"
      },
      {
        "id": "budget-app-initech",
        "max_limit": 1,
        "reset_duration": "1h",
        "virtual_key_id": "vk-initech"
      },
      {
        "id": "budget-verifier-acme",
        "max_limit": 0.016,
        "reset_duration": "1h",
        "virtual_key_id": "vk-verifier-acme"
      },
      {
        "id": "budget-verifier-globex",
        "max_limit": 0.04,
        "reset_duration": "1h",
        "virtual_key_id": "vk-verifier-globex"
      },
      {
        "id": "budget-verifier-initech",
        "max_limit": 0.024,
        "reset_duration": "1h",
        "virtual_key_id": "vk-verifier-initech"
      },
      {
        "id": "budget-cust-acme",
        "max_limit": 1,
        "reset_duration": "1h",
        "customer_id": "cust-acme"
      },
      {
        "id": "budget-cust-globex",
        "max_limit": 1,
        "reset_duration": "1h",
        "customer_id": "cust-globex"
      },
      {
        "id": "budget-cust-initech",
        "max_limit": 1,
        "reset_duration": "1h",
        "customer_id": "cust-initech"
      }
    ]
  },
  "plugins": [
    {
      "enabled": true,
      "name": "halflife",
      "config": {
        "queue_size": 256,
        "workers": 2,
        "max_claims_per_response": 5,
        "tavily_relay": "tavily",
        "gateway_url": "http://localhost:8080",
        "verifiers": [
          {
            "tenant": "vk-acme",
            "virtual_key_id": "vk-verifier-acme",
            "virtual_key": "sk-bf-halflife-verifier-acme"
          },
          {
            "tenant": "vk-globex",
            "virtual_key_id": "vk-verifier-globex",
            "virtual_key": "sk-bf-halflife-verifier-globex"
          }
        ],
        "verifier_models": [
          "openrouter/nvidia/nemotron-3.5-super-vl:free",
          "openrouter/xingchen-agi/xing4.0-29b-a4b:free",
          "openrouter/openrouter/free"
        ]
      }
    }
  ],
  "relays": [
    {
      "name": "tavily",
      "description": "Tavily Search and Extract for Halflife evidence",
      "base_url": "https://api.tavily.com",
      "auth": {
        "type": "bearer"
      },
      "credential": {
        "value": "env.TAVILY_API_KEY"
      },
      "network": {
        "timeout_seconds": 30
      },
      "usage": {
        "units_path": "usage.credits",
        "cost_per_unit": 0.008
      },
      "routes": [
        {
          "method": "POST",
          "path": "/search"
        },
        {
          "method": "POST",
          "path": "/extract"
        },
        {
          "method": "GET",
          "path": "/usage",
          "billable": false
        }
      ]
    }
  ],
  "setup_token": "halflife-test-setup-token"
}
